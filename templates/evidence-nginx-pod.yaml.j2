apiVersion: v1
kind: Pod
metadata:
  name: {{ evidence_nginx_pod_name }}
  namespace: {{ evidence_ir_namespace }}
  labels:
    app: rhacs-ir-evidence
    app.kubernetes.io/managed-by: rhacs-incident-response
    rhacs-ir/incident: "{{ ansible_date_time.epoch }}"
spec:
  restartPolicy: Never
  containers:
    # k8s_cp requires tar in the target container; hi/nginx does not ship tar.
    - name: {{ evidence_stager_container_name | default('evidence-stager') }}
      image: "{{ evidence_stager_image | default('registry.access.redhat.com/ubi9:latest') }}"
      imagePullPolicy: IfNotPresent
      command:
        - /bin/sh
        - -c
        - sleep infinity
      volumeMounts:
        - name: evidence
          mountPath: "{{ evidence_nginx_mount_path }}"
    - name: {{ evidence_nginx_container_name | default('nginx') }}
      image: "{{ evidence_nginx_image }}"
      imagePullPolicy: IfNotPresent
      ports:
        - containerPort: {{ evidence_nginx_container_port | default(8080) }}
          protocol: TCP
      volumeMounts:
        - name: evidence
          mountPath: "{{ evidence_nginx_mount_path }}"
  volumes:
    - name: evidence
      emptyDir: {}
