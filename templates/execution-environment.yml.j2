---
# Ansible Builder v3 — RHACS incident-response Controller execution environment.
# Rendered by configure_aap_eda.yml; base image requires registry authentication to pull.
version: 3

images:
  base_image:
    name: {{ aap_ee_base_image }}

options:
  # ee-minimal-rhel9 and similar AAP bases use microdnf; full UBI uses /usr/bin/dnf
  package_manager_path: {{ aap_ee_builder_package_manager_path }}

dependencies:
  ansible_core:
    package_pip: ansible-core>=2.15
  ansible_runner:
    package_pip: ansible-runner
  # Paths are relative to .build/ where this file is rendered (see configure_aap_eda.yml)
  galaxy: ../collections/requirements.yml
  python: ../requirements.txt
  system: ../bindep.txt
  # Skip collection-pulled system deps; openshift-clients comes from bindep.txt (oc for node logs)
  exclude:
    all_from_collections:
      - kubernetes.core
      - community.general
      - awx.awx
      - ansible.eda
